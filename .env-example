DB_HOST=IP_ADDRESS
DB_PORT=PORT_NUMBER
DB_NAME=DB_NAME
DB_USER=app_user # you can change this but this is by default from the database
DB_PASSWORD=DB_PSWD # change this, this is DB_USER's password

SECRET_KEY=SECRET_KEY

# Email Notification Settings (SMTP)
# Leave SMTP_HOST empty to suppress sending and log emails to console during local development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_DEFAULT_SENDER=D-IPCR System <no-reply@cict.edu.ph>
MAIL_SUPPRESS_SEND=false
APP_BASE_URL=http://127.0.0.1:5000
