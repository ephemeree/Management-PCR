# For Docker:
# DB_HOST is the compose service name "db".
# DO NOT change this: DB_PORT=3306 is MySQL's port INSIDE the container.
# The db service is not exposed to the host, so host port conflicts don't apply.

# For local dev:
# Against a real server, change it back to the server IP if hosted seperately.
# (Only local dev against a real server could change value of DB_PORT=3306.)

DB_HOST=db
DB_PORT=3306 # Read Above!
DB_NAME=ipcr_db
DB_USER=dipcr_app
DB_PASSWORD=CHANGETHIS!!!
DB_ROOT_PASSWORD=CHANGETHIS!!!

# Flask
SECRET_KEY=generate_a_random_key_here!!!
FLASK_DEBUG=false

# ADMIN/System Admin
# Only read on first startup. If an admin already exists, changing these does nothing.
ADMIN_EMAIL=CHANGE@GMAIL.COM!!
ADMIN_PASSWORD=CHANGE!!  # must satisfy the policy: 8+ chars, upper, lower, digit, special, no spaces

# Email Notification Settings (SMTP)
# Leave SMTP_HOST empty to suppress sending and log emails to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_DEFAULT_SENDER=D-IPCR System <no-reply@cict.edu.ph>
MAIL_SUPPRESS_SEND=true
APP_BASE_URL=http://127.0.0.1:5000

